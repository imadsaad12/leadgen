# Copy to .env and adjust. All values are optional; defaults are shown.
LEADGEN_DB_PATH=~/.leadgen/leadgen.db
LEADGEN_HOST=127.0.0.1
LEADGEN_PORT=8080
# LinkedIn MCP sidecar (vendored, patched fork)
LEADGEN_MCP_HOST=127.0.0.1
LEADGEN_MCP_PORT=8000
LEADGEN_MCP_PATH=/mcp
# LLM assist runs through the `claude` CLI and your Claude subscription. No API key is used or read.
LEADGEN_CLAUDE_BIN=claude
LEADGEN_CLAUDE_MODEL=sonnet
LEADGEN_CLAUDE_EFFORT=low
